{
  "name": "pixel-office-opencode",
  "version": "0.1.0",
  "type": "module",
  "description": "Pixel-art office that mirrors opencode sessions and subagents in real time.",
  "license": "GPL-3.0-only",
  "repository": "git+https://github.com/Jantilo-dev/Oficina_Opencode.git",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "probe": "tsx scripts/probe.ts",
    "clean-demo": "tsx scripts/clean-demo.ts",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/utf8-check.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
